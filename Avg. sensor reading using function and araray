
#include <stdio.h>

float average(int a[], int n)
{
    int i, sum = 0;

    for(i = 0; i < n; i++)
    {
        sum = sum + a[i];
    }

    return (float)sum / n;
}

int main()
{
    int sensor[5] = {20, 25, 30, 35, 40};

    printf("Sensor Readings:\n");

    for(int i = 0; i < 5; i++)
    {
        printf("%d\n", sensor[i]);
    }

    printf("Average Reading = %.2f", average(sensor, 5));

    return 0;
}
