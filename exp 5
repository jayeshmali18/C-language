
#include <stdio.h>

void checkSensor(int sensor[], int n)
{
    int i, sum = 0;
    float avg;

    for(i = 0; i < n; i++)
    {
        sum = sum + sensor[i];
    }

    avg = (float)sum / n;

    printf("Average Sensor Reading = %.2f\n", avg);

    if(avg > 50)
        printf("Sensor Reading is High");
    else
        printf("Sensor Reading is Normal");
}

void main()
{
    int sensor[5] = {40, 50, 60, 70, 80};

    checkSensor(sensor, 5);
}
